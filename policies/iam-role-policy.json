{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWeatherData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::pakweather-data-502274764129/data/*"
    },
    {
      "Sid": "WriteWeatherData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::pakweather-data-502274764129/data/*"
    },
    {
      "Sid": "ManageLock",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::pakweather-data-502274764129/locks/*"
    },
    {
      "Sid": "ListBucketForLockCheck",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::pakweather-data-502274764129",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["data/*", "locks/*"]
        }
      }
    }
  ]
}
